# App
NODE_ENV=production
PORT=3000
BETTER_AUTH_SECRET=replace-with-32-plus-random-chars
BETTER_AUTH_URL=http://localhost:3000

# Neon (Dashboard → Connect → Prisma / pooled). sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require

# GitHub OAuth (better-auth)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub App (webhooks + Octokit)
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
# github.com/apps/<slug> — used for the Install button (NEXT_PUBLIC_ is visible in the browser)
GITHUB_APP_SLUG=sudancodereviewer
NEXT_PUBLIC_GITHUB_APP_SLUG=sudancodereviewer
# Public GitHub PR with bot comments — shown on the homepage (no login)
NEXT_PUBLIC_SAMPLE_PR_URL=

# AI + embeddings
OPENROUTER_API_KEY=
# Reviewer model
OPENROUTER_MODEL=openai/gpt-4o-mini
# Judge model — must be different from OPENROUTER_MODEL
OPENROUTER_JUDGE_MODEL=google/gemini-2.5-flash
# If Gemini is down or the slug 404s, try this next (still OpenRouter)
OPENROUTER_JUDGE_FALLBACK_MODEL=openai/gpt-4o-mini
PINECONE_API_KEY=
PINECONE_INDEX=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Billing (Stripe Checkout)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
