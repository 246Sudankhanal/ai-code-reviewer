{
	servers {
		trusted_proxies static private_ranges
	}
}

www.aiprreviewer.com {
	redir https://aiprreviewer.com{uri} permanent
}

aiprreviewer.com {
	request_body {
		max_size 10MB
	}

	# GitHub/Stripe/Inngest + ACME: no gzip, no burst limit, longer timeouts.
	@unthrottled {
		path /api/github/webhook /api/stripe/webhook /api/inngest* /.well-known/*
	}

	handle @unthrottled {
		reverse_proxy app:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up Authorization {http.request.header.Authorization}
			header_up X-Inngest-Signature {http.request.header.X-Inngest-Signature}
			transport http {
				dial_timeout 5s
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle {
		encode gzip
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		rate_limit {
			zone per_ip_burst {
				key {client_ip}
				events 30
				window 10s
			}
			zone per_ip_minute {
				key {client_ip}
				events 120
				window 1m
			}
			zone auth {
				match {
					path /api/auth/* /sign-in
				}
				key {client_ip}
				events 20
				window 1m
			}
		}
		reverse_proxy app:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			header_up Authorization {http.request.header.Authorization}
			header_up X-Inngest-Signature {http.request.header.X-Inngest-Signature}
			transport http {
				dial_timeout 5s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	handle_errors {
		respond "{http.error.status_code} {http.error.status_text}"
	}
}
