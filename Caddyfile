{
	servers {
		trusted_proxies static private_ranges
	}
}

www.aiprreviewer.com {
	redir https://aiprreviewer.com{uri} permanent
}

aiprreviewer.com {
	request_body {
		max_size 10MB
	}

	redir /sign-in/ /sign-in 308

	# Webhooks, Inngest, ACME, and Next assets: no gzip, no burst limit.
	# First-load /_next chunks easily exceed 30 req/10s and Next then 404s client navigations.
	@unthrottled {
		path /api/github/webhook /api/stripe/webhook /api/inngest* /.well-known* /_next/*
	}

	# RSC / prefetch flights break if Caddy gzips them.
	@rsc {
		header RSC *
	}

	handle @unthrottled {
		reverse_proxy app:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				read_timeout 120s
				write_timeout 120s
			}
		}
	}

	handle @rsc {
		reverse_proxy app:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	handle {
		encode gzip
		header {
			X-Content-Type-Options nosniff
			Referrer-Policy strict-origin-when-cross-origin
			X-Frame-Options DENY
		}
		rate_limit {
			zone per_ip_burst {
				key {client_ip}
				events 80
				window 10s
			}
			zone per_ip_minute {
				key {client_ip}
				events 240
				window 1m
			}
			zone auth {
				match {
					path /api/auth/* /sign-in /sign-in/
				}
				key {client_ip}
				events 40
				window 1m
			}
		}
		reverse_proxy app:3000 {
			header_up Host {host}
			header_up X-Forwarded-Host {host}
			header_up X-Forwarded-Proto {scheme}
			transport http {
				dial_timeout 5s
				read_timeout 60s
				write_timeout 60s
			}
		}
	}

	handle_errors {
		respond "{http.error.status_code} {http.error.status_text}"
	}
}
